+COMPARE_LIMITS = [
+    "Compares evidence metadata and SHA256 bytes only; visual quality is not verified.",
+    "PNG/JPEG header dimensions do not establish image authenticity, rendering or acceptance.",
+]
+
+
+def compare_result():
+    return {"comparison_contract_valid": False, "comparable": False,
+            "visual_quality_verified": False, "screens": [], "limits": COMPARE_LIMITS}
+
+
+def strict_json(raw):
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value:
+                raise ValueError("Duplicate JSON key: " + key)
+            value[key] = item
+        return value
+
+    def invalid_constant(value):
+        raise ValueError("Nonfinite JSON constant: " + value)
+
+    result = json.loads(raw, object_pairs_hook=pairs, parse_constant=invalid_constant)
+    # Overflowing exponent literals are nonfinite too.
+    def finite(value):
+        if isinstance(value, float) and not __import__("math").isfinite(value):
+            raise ValueError("Nonfinite JSON number")
+        if isinstance(value, dict):
+            for item in value.values():
+                finite(item)
+        elif isinstance(value, list):
+            for item in value:
+                finite(item)
+    finite(result)
+    return result
+
+
+def nonempty(value):
+    return isinstance(value, str) and bool(value.strip())
+
+
+def evidence_bytes(root, value):
+    if not nonempty(value):
+        raise ValueError("Reference must be a nonempty relative path")
+    relative = Path(value)
+    windows = PureWindowsPath(value)
+    if (relative.is_absolute() or windows.is_absolute() or windows.drive or
+            windows.root or ".." in relative.parts or ".." in windows.parts):
+        raise ValueError("Reference must stay inside manifest root: " + value)
+    target = (root / relative).resolve(strict=True)
+    if not target.is_relative_to(root):
+        raise ValueError("Reference escapes manifest root: " + value)
+    if not target.is_file():
+        raise ValueError("Reference must be a regular file: " + value)
+    raw = target.read_bytes()
+    if not raw:
+        raise ValueError("Reference is empty: " + value)
+    return raw
+
+
+def image_dimensions(raw, name):
+    suffix = Path(name).suffix.lower()
+    if suffix == ".png":
+        if (len(raw) < 33 or raw[:8] != b"\x89PNG\r\n\x1a\n" or
+                raw[8:16] != b"\x00\x00\x00\rIHDR"):
+            raise ValueError("Malformed PNG header: " + name)
+        if zlib.crc32(raw[12:29]) & 0xffffffff != struct.unpack(">I", raw[29:33])[0]:
+            raise ValueError("Invalid PNG header checksum: " + name)
+        width, height, depth, color, compression, filtering, interlace = struct.unpack(">IIBBBBB", raw[16:29])
+        depths = {0: (1, 2, 4, 8, 16), 2: (8, 16), 3: (1, 2, 4, 8),
+                  4: (8, 16), 6: (8, 16)}
+        if (not width or not height or width > 0x7fffffff or height > 0x7fffffff or
+                depth not in depths.get(color, ()) or compression or filtering or interlace not in (0, 1)):
+            raise ValueError("Invalid PNG dimensions/header: " + name)
+        return width, height
+    if suffix not in (".jpg", ".jpeg") or raw[:2] != b"\xff\xd8":
+        raise ValueError("Expected actual PNG/JPEG image: " + name)
+    offset = 2
+    frames = set(range(0xc0, 0xd0)) - {0xc4, 0xc8, 0xcc}
+    while offset < len(raw):
+        if raw[offset] != 0xff:
+            break
+        while offset < len(raw) and raw[offset] == 0xff:
+            offset += 1
+        if offset >= len(raw):
+            break
+        marker = raw[offset]
+        offset += 1
+        if marker in (0, 0xd8, 0xd9, 0xda):
+            break
+        if marker == 1 or 0xd0 <= marker <= 0xd7:
+            continue
+        if offset + 2 > len(raw):
+            break
+        length = int.from_bytes(raw[offset:offset + 2], "big")
+        if length < 2 or offset + length > len(raw):
+            break
+        if marker in frames:
+            segment = raw[offset + 2:offset + length]
+            if len(segment) < 6:
+                break
+            precision, height, width, components = struct.unpack(">BHHB", segment[:6])
+            if not width or not height or not components or len(segment) != 6 + 3 * components or precision not in (8, 12, 16):
+                break
+            return width, height
+        offset += length
+    raise ValueError("Malformed JPEG header: " + name)
+
