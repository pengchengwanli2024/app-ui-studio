+def load_capture(filename):
+    path = Path(filename).resolve(strict=True)
+    if not path.is_file():
+        raise ValueError("Capture manifest must be a regular file")
+    root = path.parent
+    data = strict_json(path.read_text(encoding="utf-8-sig"))
+    if not isinstance(data, dict):
+        raise ValueError("Capture manifest must be an object")
+    if type(data.get("schema_version")) is not int or data["schema_version"] != 1:
+        raise ValueError("schema_version must be integer 1")
+    for key in ("product", "plugin_version"):
+        if not nonempty(data.get(key)):
+            raise ValueError(key + " must be a nonempty string")
+    if not isinstance(data.get("capture_context"), dict) or not data["capture_context"]:
+        raise ValueError("capture_context must be a nonempty object")
+    plugin_name = data.get("plugin_manifest")
+    plugin_bytes = evidence_bytes(root, plugin_name)
+    if Path(plugin_name).suffix.lower() != ".json":
+        raise ValueError("plugin_manifest must reference JSON")
+    plugin = strict_json(plugin_bytes.decode("utf-8-sig"))
+    if not isinstance(plugin, dict) or plugin.get("version") != data["plugin_version"]:
+        raise ValueError("Plugin version must match plugin_version")
+    result = {key: data[key] for key in ("product", "capture_context", "plugin_version")}
+    for key in ("business_files", "brand_assets"):
+        items = data.get(key)
+        if not isinstance(items, list) or not items:
+            raise ValueError(key + " must be a nonempty list")
+        hashes = {}
+        for value in items:
+            raw = evidence_bytes(root, value)
+            if value in hashes:
+                raise ValueError(key + " contains duplicate paths")
+            hashes[value] = hashlib.sha256(raw).hexdigest()
+        result[key] = hashes
+    screens = data.get("screens")
+    if not isinstance(screens, list) or not screens:
+        raise ValueError("screens must be a nonempty list")
+    result["screens"] = {}
+    for item in screens:
+        if not isinstance(item, dict) or not nonempty(item.get("id")):
+            raise ValueError("Screen must have a nonempty string id")
+        identity = item["id"]
+        if identity in result["screens"]:
+            raise ValueError("Duplicate screen id: " + identity)
+        viewport = item.get("viewport")
+        if not isinstance(viewport, dict) or any(type(viewport.get(k)) is not int or viewport[k] <= 0 for k in ("width", "height")):
+            raise ValueError("Screen viewport requires positive integer width and height")
+        raw = evidence_bytes(root, item.get("artifact"))
+        if image_dimensions(raw, item["artifact"]) != (viewport["width"], viewport["height"]):
+            raise ValueError("Actual image dimensions differ from viewport: " + identity)
+        result["screens"][identity] = {"artifact": item["artifact"],
+            "viewport": {k: viewport[k] for k in ("width", "height")},
+            "sha256": hashlib.sha256(raw).hexdigest()}
+    return result
