+def capture_manifest(argument):
+    path = Path(argument).expanduser().resolve(strict=True)
+    if not path.is_file():
+        raise ValueError("Input manifest must be a regular file")
+    root = path.parent
+    data = strict_json(path.read_bytes())
+    if not isinstance(data, dict):
+        raise ValueError("Capture manifest must be a JSON object")
+    if type(data.get("schema_version")) is not int or data["schema_version"] != 1:
+        raise ValueError("schema_version must be integer 1")
+    for key in ("product", "plugin_version"):
+        if not isinstance(data.get(key), str) or not data[key].strip():
+            raise ValueError(f"{key} must be a nonempty string")
+    context = data.get("capture_context")
+    if not isinstance(context, dict) or not context:
+        raise ValueError("capture_context must be a nonempty object")
+    plugin = strict_json(evidence_bytes(root, data.get("plugin_manifest")))
+    if not isinstance(plugin, dict) or plugin.get("version") != data["plugin_version"]:
+        raise ValueError("Plugin manifest version must match plugin_version")
+    hashes = {}
+    for key in ("business_files", "brand_assets"):
+        values = data.get(key)
+        if not isinstance(values, list) or not values:
+            raise ValueError(f"{key} must be a nonempty list")
+        hashes[key] = {}
+        for value in values:
+            raw = evidence_bytes(root, value)
+            if value in hashes[key]:
+                raise ValueError(f"Duplicate {key} path: {value}")
+            hashes[key][value] = hashlib.sha256(raw).hexdigest()
+    screens = data.get("screens")
+    if not isinstance(screens, list) or not screens:
+        raise ValueError("screens must be a nonempty list")
+    entries = {}
+    for item in screens:
+        if not isinstance(item, dict):
+            raise ValueError("Screen must be an object")
+        name = item.get("id")
+        if not isinstance(name, str) or not name.strip() or name in entries:
+            raise ValueError("Screen IDs must be nonempty unique strings")
+        viewport = item.get("viewport")
+        if not isinstance(viewport, dict) or any(
+                type(viewport.get(k)) is not int or viewport[k] <= 0
+                for k in ("width", "height")):
+            raise ValueError(f"Screen {name}: viewport dimensions must be positive integers")
+        raw = evidence_bytes(root, item.get("artifact"))
+        if image_dimensions(raw) != (viewport["width"], viewport["height"]):
+            raise ValueError(f"Screen {name}: actual dimensions do not match viewport")
+        entries[name] = {"artifact": item["artifact"],
+                         "viewport": {k: viewport[k] for k in ("width", "height")},
+                         "sha256": hashlib.sha256(raw).hexdigest()}
+    return {"product": data["product"], "plugin_version": data["plugin_version"],
+            "capture_context": context, **hashes, "screens": entries}
+
+
+def compare(args):
+    inputs, errors = [], []
+    # Validate both sides even if the first side fails or differs.
+    for label, argument in (("baseline", args.baseline), ("candidate", args.candidate)):
+        try:
+            inputs.append(capture_manifest(argument))
+        except (OSError, ValueError, TypeError, RecursionError) as exc:
+            inputs.append(None)
+            errors.append(f"{label}: {exc}")
+    if errors:
+        emit(compare_error(errors))
+        return 2
+    baseline, candidate = inputs
+    differences = []
+    for key in ("product", "capture_context", "business_files", "brand_assets"):
+        # JSON serialization keeps bool, number and string types distinct.
+        if json.dumps(baseline[key], sort_keys=True) != json.dumps(candidate[key], sort_keys=True):
+            differences.append(f"{key} differs")
+    if baseline["screens"].keys() != candidate["screens"].keys():
+        differences.append("screen ID sets differ")
+    screens = []
+    for name in sorted(baseline["screens"].keys() | candidate["screens"].keys()):
+        left, right = baseline["screens"].get(name), candidate["screens"].get(name)
+        screen = {"id": name, "baseline": left, "candidate": right}
+        if left is not None and right is not None:
+            screen["changed"] = left["sha256"] != right["sha256"]
+            if left["viewport"] != right["viewport"]:
+                differences.append(f"screen {name}: viewport differs")
+        screens.append(screen)
+    report = {"comparison_contract_valid": True, "comparable": not differences,
+              "visual_quality_verified": False, "screens": screens, "limits": COMPARE_LIMITS,
+              "baseline_version": baseline["plugin_version"],
+              "candidate_version": candidate["plugin_version"], "differences": differences}
+    if args.output is not None:
+        try:
+            # O_EXCL refuses existing files and both live and broken symlinks.
+            with Path(args.output).expanduser().open("x", encoding="utf-8") as output:
+                output.write(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+        except (OSError, ValueError) as exc:
+            emit(compare_error([f"output: {exc}"]))
+            return 2
+    emit(report)
+    return 1 if differences else 0
+
+
+class CompareArgumentParser(argparse.ArgumentParser):
+    def error(self, message):
+        raise ValueError(message)
+
+
+def compare_cli(arguments):
+    parser = CompareArgumentParser(prog="studio.py compare", description="Compare local capture evidence")
+    parser.add_argument("baseline")
+    parser.add_argument("candidate")
+    parser.add_argument("--output")
+    try:
+        return compare(parser.parse_args(arguments))
+    except (OSError, ValueError, TypeError, RecursionError) as exc:
+        emit(compare_error([str(exc)]))
+        return 2
+
