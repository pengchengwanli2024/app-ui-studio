+COMPARE_LIMITS = [
+    "Checks comparable local evidence and byte changes only; visual quality is not verified.",
+    "Image headers and dimensions do not establish image authenticity or rendered behavior.",
+]
+
+
+def compare_error(errors):
+    return {"comparison_contract_valid": False, "comparable": False,
+            "visual_quality_verified": False, "screens": [],
+            "limits": COMPARE_LIMITS, "errors": errors}
+
+
+def strict_json(raw):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError(f"Duplicate JSON key: {key}")
+            result[key] = value
+        return result
+
+    def constant(value):
+        raise ValueError(f"Nonfinite JSON constant: {value}")
+
+    def floating(value):
+        number = float(value)
+        if not math.isfinite(number):
+            raise ValueError("Nonfinite JSON number")
+        return number
+
+    return json.loads(raw.decode("utf-8-sig"), object_pairs_hook=pairs,
+                      parse_constant=constant, parse_float=floating)
+
+
+def evidence_bytes(root, value):
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError("Evidence path must be a nonempty relative string")
+    windows = PureWindowsPath(value)
+    relative = Path(value)
+    if (relative.is_absolute() or windows.drive or windows.root or
+            ".." in relative.parts or ".." in windows.parts):
+        raise ValueError(f"Evidence path must stay inside manifest root: {value}")
+    path = (root / relative).resolve(strict=True)
+    if not path.is_relative_to(root):
+        raise ValueError(f"Evidence path escapes manifest root: {value}")
+    if not path.is_file():
+        raise ValueError(f"Evidence is not a regular file: {value}")
+    raw = path.read_bytes()
+    if not raw:
+        raise ValueError(f"Evidence is empty: {value}")
+    return raw
+
+
+def image_dimensions(raw):
+    if raw.startswith(b"\x89PNG\r\n\x1a\n"):
+        if len(raw) < 33 or raw[8:16] != b"\x00\x00\x00\x0dIHDR":
+            raise ValueError("Malformed PNG IHDR")
+        header = raw[16:29]
+        width, height, depth, color, compression, filtering, interlace = struct.unpack(
+            ">IIBBBBB", header)
+        depths = {0: (1, 2, 4, 8, 16), 2: (8, 16), 3: (1, 2, 4, 8),
+                  4: (8, 16), 6: (8, 16)}
+        if (not width or not height or width > 2147483647 or height > 2147483647 or
+                depth not in depths.get(color, ()) or compression or filtering or
+                interlace not in (0, 1) or
+                zlib.crc32(raw[12:29]) != int.from_bytes(raw[29:33], "big")):
+            raise ValueError("Malformed PNG header")
+        return width, height
+    if raw.startswith(b"\xff\xd8"):
+        pos = 2
+        frames = {0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7,
+                  0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf}
+        while pos < len(raw):
+            if raw[pos] != 0xff:
+                raise ValueError("Malformed JPEG marker")
+            while pos < len(raw) and raw[pos] == 0xff:
+                pos += 1
+            if pos >= len(raw):
+                break
+            marker = raw[pos]
+            pos += 1
+            if marker in (0, 0xd8):
+                raise ValueError("Malformed JPEG marker")
+            if marker in (0xd9, 0xda):
+                break
+            if marker == 1 or 0xd0 <= marker <= 0xd7:
+                continue
+            if pos + 2 > len(raw):
+                break
+            length = int.from_bytes(raw[pos:pos + 2], "big")
+            if length < 2 or pos + length > len(raw):
+                raise ValueError("Truncated JPEG segment")
+            if marker in frames:
+                if length < 8:
+                    raise ValueError("Malformed JPEG frame")
+                depth = raw[pos + 2]
+                height, width = struct.unpack(">HH", raw[pos + 3:pos + 7])
+                count = raw[pos + 7]
+                if not width or not height or not depth or not count or length != 8 + 3 * count:
+                    raise ValueError("Malformed JPEG frame")
+                return width, height
+            pos += length
+        raise ValueError("JPEG has no complete dimension header")
+    raise ValueError("Evidence must have a PNG or JPEG header")
+
